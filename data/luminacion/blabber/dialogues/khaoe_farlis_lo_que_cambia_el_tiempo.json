{
  "$schema": "https://ladysnake.org/schemas/blabber/dialogue.schema.json",
  "layout": { "type": "blabber:rpg" },
  "name": "Khaoe & Farlis",
  "start_at": "f1",
  "states": {

    "f1": {
      "text": "Farlis: Mil años, dice la feria. Mil años desde qué, nunca me quedó del todo claro.",
      "action": {
        "type": "blabber:command",
        "value": "execute as @e[type=taterzens:npc,name=Farlis,limit=1] run function luminacion:npcs/_shared/look_up"
      },
      "choices": [{ "text": "...", "next": "k1" }]
    },

    "k1": {
      "text": "Khaoe: Depende de quién cuente la historia. En Lundria el tiempo se contaba distinto. Cada templo con su propio calendario.",
      "action": {
        "type": "blabber:command",
        "value": "execute as @e[type=taterzens:npc,name=Khaoe,limit=1] run function luminacion:npcs/_shared/nod_left_right"
      },
      "choices": [{ "text": "...", "next": "f2" }]
    },

    "f2": {
      "text": "Farlis: Un castillo de guerra hecho huerta común. Un templo con mil comienzos. Todo termina significando otra cosa, si esperas lo suficiente.",
      "action": {
        "type": "blabber:command",
        "value": "execute as @e[type=taterzens:npc,name=Farlis,limit=1] run function luminacion:npcs/_shared/gesture_palms_up"
      },
      "choices": [{ "text": "...", "next": "k2" }]
    },

    "k2": {
      "text": "Khaoe: O si alguien se toma el trabajo de cambiarlo.",
      "action": {
        "type": "blabber:command",
        "value": "execute as @e[type=taterzens:npc,name=Khaoe,limit=1] run function luminacion:npcs/_shared/gesture_point"
      },
      "choices": [{ "text": "...", "next": "end" }]
    },

    "end": {
      "type": "end_dialogue",
      "action": {
        "type": "blabber:command",
        "value": "execute as @interlocutor run function luminacion:npcs/khaoe/resume_routine"
      }
    }

  }
}
